# Archivos reales del Minsal para pruebas (principio 22: datos reales fuera del
# repositorio). Se leen desde disco, nunca se versionan.
portal/archivos/
*.xlsm
!portal/public/**/*.xlsm

# Respaldos locales de la base y de los archivos subidos: llevan datos reales
# (principio 22). Se generan con 01-TOOLS/backup y nunca se versionan.
backup_mvp_v2/

# Assets de UI: se versiona SOLO el directorio en uso. Los respaldos, las
# extracciones y los zip de descarga son insumos locales, no parte del portal.
portal/public/assets/adminlte.v3.backup/
portal/public/assets/adminlte4_extracted/
portal/public/assets/*.zip

