APP_NAME="Portal M7"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/Cargas/portal/public

# Zona horaria y locale del dominio REM (Constitución, principio 11).
# En Laravel 12 el timezone NO se lee de .env por sí solo: config/app.php
# debe tener env('APP_TIMEZONE', ...). Ver docs/stack/prototipo-laravel-12.md
APP_TIMEZONE=America/Santiago
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos: MariaDB local -> MySQL 8 en producción.
# El modo estricto se fija en config/database.php, no se hereda del servidor.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cargas_rem
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Sesión de 8 horas (R-ID-14). Local sin HTTPS: secure=false.
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Local: el correo se escribe en el log, no se envía.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="portal@estadisticas.ssosorno.cl"
MAIL_FROM_NAME="${APP_NAME}"

# Validación REM
REM_MAX_ARCHIVO_KB=2048
